{
  "name": "StryveForms",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "@trpc/server": "^11.19.0",
      "better-auth": "1.7.7",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@trpc/client": "^11.19.0",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "dev:web": "vp run --filter web dev",
    "dev:tui": "vp run --filter tui dev",
    "dev:server": "vp run --filter server dev",
    "db:push": "vp run --filter @StryveForms/db db:push",
    "db:studio": "vp run --filter @StryveForms/db db:studio",
    "db:generate": "vp run --filter @StryveForms/db db:generate",
    "db:migrate": "vp run --filter @StryveForms/db db:migrate",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@StryveForms/config": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@types/bun": "catalog:",
    "husky": "latest",
    "rolldown": "1.2.13",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "packageManager": "bun@1.4.2"
}
