# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url @sensitive=false
BETTER_AUTH_URL=

# @type=url @sensitive=false
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# ----- StryveForms -----

# Public URL of the web app (used in share links and emails)
# @type=url @sensitive=false
APP_URL=http://localhost:3001

# Display name used in emails and the UI
# @sensitive=false @required=false
APP_NAME=StryveForms

# Where uploaded files are stored: `local` (disk) or `s3` (any S3-compatible service)
# @sensitive=false @type=enum(local, s3)
STORAGE_DRIVER=local

# Folder for local storage (relative to apps/server)
# @sensitive=false @required=false
STORAGE_PATH=./storage

# @required=false
S3_BUCKET=
# @required=false
S3_REGION=
# @required=false
S3_ENDPOINT=
# @required=false
S3_ACCESS_KEY_ID=
# @required=false
S3_SECRET_ACCESS_KEY=

# SMTP for outgoing email. Leave SMTP_HOST empty to log emails to the console instead.
# @required=false @sensitive=false
SMTP_HOST=
# @required=false @sensitive=false @type=number
SMTP_PORT=587
# @required=false
SMTP_USER=
# @required=false
SMTP_PASSWORD=
# @required=false @sensitive=false @type=boolean
SMTP_SECURE=false
# @required=false @sensitive=false
MAIL_FROM=StryveForms <no-reply@localhost>

# Captcha secrets (only needed for forms that enable captcha)
# @required=false
RECAPTCHA_SECRET_KEY=
# @required=false
HCAPTCHA_SECRET_KEY=
# @required=false
TURNSTILE_SECRET_KEY=

# Max requests per minute to OpnForm during imports
# @required=false @sensitive=false @type=number
OPNFORM_IMPORT_RATE_LIMIT=60

# Largest file POST /api/backups/upload accepts (MB) — a workspace export/import file or an instance .stryve-backup
# @required=false @sensitive=false @type=number
BACKUP_MAX_UPLOAD_MB=20480

# Passkey (WebAuthn) relying-party ID — the exact hostname users sign in on. Leave unset to derive it from APP_URL,
# which is correct for a normal single-domain deployment. Only set this if APP_URL's hostname isn't what the browser
# actually shows during sign-in (e.g. a reverse proxy that rewrites the host). Changing it after passkeys have been
# registered invalidates them — a user would need to add a new passkey.
# @required=false @sensitive=false
WEBAUTHN_RP_ID=
