NODE_ENV=production
# openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Public URL of the web app. The web app forwards /api and /trpc to this server,
# so all three are the same address.
BETTER_AUTH_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002
APP_URL=http://localhost:3002
APP_NAME=StryveForms
DATABASE_URL=postgresql://postgres:password@localhost:5432/StryveForms

STORAGE_DRIVER=local
STORAGE_PATH=./storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Leave SMTP_HOST empty to print emails to the server log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=StryveForms <no-reply@example.com>

# HCAPTCHA_SECRET_KEY=
# RECAPTCHA_SECRET_KEY=
# TURNSTILE_SECRET_KEY=
# Public captcha site keys (sent to the browser with each form)
# HCAPTCHA_SITE_KEY=
# RECAPTCHA_SITE_KEY=
# TURNSTILE_SITE_KEY=
# TELEGRAM_BOT_TOKEN=
# TRUST_PROXY=true
# ALLOW_PRIVATE_WEBHOOKS=false
OPNFORM_IMPORT_RATE_LIMIT=60
