NODE_ENV=development
# Leave empty: the web app forwards /api and /trpc to SERVER_URL (one domain, first-party cookies).
VITE_SERVER_URL=
# Internal address of the API server
SERVER_URL=http://localhost:3000
# Web app port (3001 is often taken by other dev tools)
PORT=3002
