# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Public URL of the API server. Leave EMPTY (recommended): the web app then
# forwards /api and /trpc to SERVER_URL, so everything runs on one domain.
# @public @type=url @required=false
VITE_SERVER_URL=

# Internal address of the API server, used by the proxy and server-side rendering
# @type=url @sensitive=false @required=false
SERVER_URL=http://localhost:3000

# Port of the web app
# @type=number @sensitive=false @required=false
PORT=3002

# Public captcha site keys (optional)
# @public @required=false
VITE_RECAPTCHA_SITE_KEY=
# @public @required=false
VITE_HCAPTCHA_SITE_KEY=
# @public @required=false
VITE_TURNSTILE_SITE_KEY=
