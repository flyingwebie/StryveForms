**/node_modules
.git

# Build outputs (only at package roots, so source folders named build/dist are kept)
apps/*/dist
packages/*/dist
apps/*/build
packages/*/build
**/.next
**/.nuxt
**/.output
**/.svelte-kit
**/.astro
**/.turbo
.turbo

**/.wrangler
**/.alchemy
